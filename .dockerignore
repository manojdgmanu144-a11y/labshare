# Version control
.git
.gitignore

# Source node_modules (never copy these — stages install their own)
node_modules
server/node_modules
client/node_modules

# Dev / test artifacts
# Note: client/src and client/public are intentionally NOT excluded here.
# The build-client stage (npm run build) needs them to compile the SPA.
# client/dist is excluded because it is generated inside the build stage.
client/dist
server/tests
coverage
*.log

# Secrets — never bake .env files into the image
.env
.env.*
!.env.example

# Docker itself
Dockerfile
.dockerignore

# Docs / misc
README.md
supabase
